PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/pizza?retryWrites=true&w=majority
JWT_SECRET=change_me
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
# Admin account (created by `npm run seed`) and low-stock alert recipient
ADMIN_EMAIL=admin@pizzeria.test
ADMIN_PASSWORD=Admin@12345
# Razorpay TEST keys (dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# SMTP (optional). If SMTP_HOST is empty, an Ethereal test inbox is used and preview links are printed in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pizzeria <no-reply@pizzeria.test>"
# node-cron expression for the low-stock check
CRON_SCHEDULE=*/15 * * * *
